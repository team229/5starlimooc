---
/**
 * Fleet index — the vehicles in our garage.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { fleet } from '../../data/fleet';

const extra = [
  { label: 'Stretch SUV Limo Rentals', href: '/fleet/stretch-suv-limo-rentals/' },
  { label: 'Lincoln MKT Stretch Limo', href: '/fleet/stretch-suv-limo-rentals/' },
  { label: 'Shuttle Van', href: '/shuttle-van-service/' },
  { label: '50 Passenger Party Bus', href: '/services/large-50-passenger-party-bus-service/' },
];
---

<BaseLayout
  title="Our Fleet | Escalade, Hummer, Party Bus & Stretch Limos"
  description="Explore the 5 Star Limousine fleet: Cadillac Escalade limos, Hummer limos, party buses, Chrysler 300 limos, Mercedes Sprinter limos and luxury SUVs in Orange County."
  path="/fleet/"
  breadcrumbs={[{ name: 'Fleet', href: '' }]}
>
  <PageHero
    eyebrow="The fleet"
    title="Your Trusted Limousine Rental Service in Anaheim & Orange County"
    breadcrumbs={[{ name: 'Fleet', href: '' }]}
  />

  <section class="container-site py-14 md:py-20">
    <div class="grid gap-7 sm:grid-cols-2 lg:grid-cols-3">
      {
        fleet.map((car, i) => (
          <article class="card-dark group flex flex-col overflow-hidden transition-transform duration-300 hover:-translate-y-1.5">
            <div class="relative aspect-[3/2] overflow-hidden bg-black">
              <img
                src={car.image}
                alt={car.alt}
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
                decoding="async"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/85 to-transparent" />
              <span class="absolute top-4 left-4 font-accent text-sm text-gold/70">
                {String(i + 1).padStart(2, '0')}
              </span>
            </div>
            <div class="flex flex-1 flex-col p-6">
              <h2 class="font-display text-xl font-bold text-white">{car.name}</h2>
              <p class="mt-2.5 flex-1 text-sm leading-relaxed text-white/65">{car.tagline}</p>
              <a href={car.href} class="mt-5 inline-flex items-center gap-2 text-[13px] font-extrabold tracking-[0.14em] text-gold uppercase hover:text-gold-soft">
                Read More
                <Icon name="arrow-right" class="h-4 w-4 transition-transform group-hover:translate-x-1" />
              </a>
            </div>
          </article>
        ))
      }
    </div>

    <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        extra.map((e) => (
          <a href={e.href} class="card-dark flex items-center justify-between gap-3 px-5 py-4 transition-transform hover:-translate-y-0.5">
            <span class="text-[15px] font-semibold text-white/85 hover:text-gold">{e.label}</span>
            <Icon name="arrow-right" class="h-4 w-4 shrink-0 text-gold" />
          </a>
        ))
      }
    </div>
  </section>

  <CtaBand />
</BaseLayout>
