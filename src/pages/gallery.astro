---
/**
 * Gallery — curated photo grid with category filters and a lightbox.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import GalleryGrid from '../components/GalleryGrid.astro';
import CtaBand from '../components/CtaBand.astro';
import { galleryImages } from '../data/gallery';
import site from '../data/site';

const description =
  'Explore our Anaheim Orange County limo gallery! View luxury limousines, party buses and more from 5 Star Limousine Service.';

const tel = site.phone.replace(/[^\d+]/g, '');
---

<BaseLayout title="Gallery | 5 Star Limo OC" {description} path="/gallery/" breadcrumbs={[{ name: 'Gallery', href: '' }]}>
  <PageHero eyebrow="See the fleet" title="Gallery" breadcrumbs={[{ name: 'Gallery', href: '' }]} />

  <GalleryGrid />

  <!-- booking strip -->
  <section class="border-y border-line bg-carbon">
    <div
      class="container-site flex flex-col items-center gap-5 py-10 text-center md:flex-row md:justify-between md:text-left"
    >
      <div>
        <p class="eyebrow mb-2">Like what you see?</p>
        <h2 class="heading-gold text-xl font-bold md:text-2xl">
          Book any of these vehicles for your event — most with 1 hour free
        </h2>
      </div>
      <a href={`tel:${tel}`} class="btn-gold shrink-0">Reserve Your Ride</a>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
