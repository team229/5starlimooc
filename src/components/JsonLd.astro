---
/**
 * LocalBusiness / Organization / WebSite structured data.
 * URLs use the canonical domain for SEO but no asset is ever loaded from it.
 */
import site from '../data/site';

interface Props {
  path?: string;
  title?: string;
  description?: string;
  image?: string;
  date?: string;
  breadcrumbs?: Array<{ name: string; href: string }>;
  kind?: string;
  /** Q/A pairs for FAQPage schema. Omit to emit no FAQPage markup. */
  faq?: Array<{ question: string; answer: string }>;
}

const {
  path = '/',
  title,
  description = site.description,
  image = site.logo,
  date = '',
  breadcrumbs = [],
  kind = 'page',
  faq = [],
} = Astro.props;

const pageUrl = `${site.url}${path}`;
const img = image?.startsWith('/') ? `${site.url}${image}` : image;

const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: site.name,
  description: site.description,
  email: site.email,
  image: `${site.url}${site.logo}`,
  '@id': `${site.url}/#localbusiness`,
  url: site.url + '/',
  telephone: site.phone,
  priceRange: site.priceRange,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.city,
    addressRegion: site.address.region,
    postalCode: site.address.postalCode,
    addressCountry: site.address.country,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: site.geo.lat,
    longitude: site.geo.lng,
  },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: site.rating.value,
    reviewCount: site.rating.count,
  },
  sameAs: [site.social.facebook, site.social.maps],
  additionalType: [
    'https://en.wikipedia.org/wiki/Limousine',
    'https://en.wikipedia.org/wiki/Chauffeur',
    'https://en.wikipedia.org/wiki/Transportation',
  ],
  openingHoursSpecification: [
    'Monday',
    'Tuesday',
    'Wednesday',
    'Thursday',
    'Friday',
    'Saturday',
    'Sunday',
  ].map((dayOfWeek) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek,
    opens: '00:00',
    closes: '23:59',
  })),
};

const website = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${site.url}/#schema-publishing-organization`,
      url: site.url,
      name: site.shortName,
      description: site.description,
      logo: `${site.url}${site.logo}`,
      sameAs: [site.social.facebook, site.social.instagram, site.social.yelp, site.social.youtube],
    },
    {
      '@type': 'WebSite',
      '@id': `${site.url}/#schema-website`,
      url: site.url,
      name: site.name,
      encoding: 'UTF-8',
    },
  ],
};

const entity = {
  '@context': 'https://schema.org',
  '@type': kind === 'post' ? 'Article' : 'WebPage',
  headline: title || site.name,
  description,
  url: pageUrl,
  ...(img ? { image: img } : {}),
  ...(kind === 'post' && date ? { datePublished: date } : {}),
  ...(kind === 'post'
    ? {
        author: { '@type': 'Organization', name: site.shortName },
        publisher: { '@type': 'Organization', name: site.shortName, logo: { '@type': 'ImageObject', url: `${site.url}${site.logo}` } },
      }
    : {}),
};

const breadcrumb =
  breadcrumbs.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
          ...breadcrumbs.map((b, i) => ({
            '@type': 'ListItem',
            position: i + 2,
            name: b.name,
            item: b.href.startsWith('http') ? b.href : `${site.url}${b.href}`,
          })),
        ],
      }
    : null;

/**
 * FAQPage from an explicit list. Answers still containing unresolved
 * [PLACEHOLDER] markup are dropped — shipping bracket tokens to Google inside
 * structured data is worse than emitting no FAQPage at all.
 */
const faqEntities = faq
  .filter(({ answer }) => !/\[[A-Z][^\]]*\]/.test(answer))
  .map(({ question, answer }) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer },
  }));

const faqSchema =
  faqEntities.length > 0
    ? { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqEntities }
    : null;
---

<script type="application/ld+json" set:html={JSON.stringify(localBusiness)}></script>
<script type="application/ld+json" set:html={JSON.stringify(website)}></script>
<script type="application/ld+json" set:html={JSON.stringify(entity)}></script>
{breadcrumb && <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)}></script>}
{faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>}
