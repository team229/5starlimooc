---
/**
 * Homepage — exact replication of https://5starlimooc.com/ sections.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Halloween from '../components/Halloween.astro';
import FleetShowcase from '../components/FleetShowcase.astro';
import Reviews from '../components/Reviews.astro';
import OccasionGrid from '../components/OccasionGrid.astro';
import WhyChoose from '../components/WhyChoose.astro';
import ServiceAreas from '../components/ServiceAreas.astro';
import site from '../data/site';

const description =
  'Experience luxury transportation with 5 Star Limo Service & Party Bus Rental in Orange County. Book premium limo and party bus rentals today.';
---

<BaseLayout
  title="5 Star Limo Service & Party Bus Rental Near You in Orange County"
  description={description}
  path="/"
  image={site.logo}
>
  <div class="home-starfield">
    <Hero />
    <Halloween />
    <FleetShowcase />
    <Reviews />
    <OccasionGrid />
    <WhyChoose />
    <ServiceAreas />
  </div>
</BaseLayout>

<style>
  /* Whole-homepage gold starfield. A fixed layer sits behind everything (negative
     z-index, so it never covers in-flow content); the solid black section blocks
     below are made transparent so it shows through, while each section's own
     cards/panels stay opaque for readability. */
  .home-starfield {
    position: relative;
  }

  .home-starfield::before {
    content: '';
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: #000 url('/images/backgrounds/starfield-night.webp') center center / cover no-repeat;
  }

  /* Reveal the fixed starfield behind the solid black section blocks */
  .home-starfield :global(section) {
    background-color: transparent !important;
  }
</style>
