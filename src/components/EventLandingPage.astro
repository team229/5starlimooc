---
/**
 * Full page body for a seasonal event landing page.
 *
 * Composed by the thin route files:
 *   pages/homecoming-limo-party-bus-orange-county.astro
 *   pages/oktoberfest-fall-festival-party-bus-orange-county.astro
 *
 * Structure (all heading levels intentional for SEO + conversions):
 *   H1 (PageHero) → intro → trust stats → H2 "Why book" → H2 "How it works"
 *   → H2 "Rates" → H2 "What's included" + H2 "Cities" → H2 "Popular routes"
 *   → H2 "Choose your ride" → H2 "Reviews" → H2 "FAQ" → related → CTA band.
 */
import PageHero from './PageHero.astro';
import CtaBand from './CtaBand.astro';
import Icon from './Icon.astro';
import site from '../data/site';
import { landingStats, bookingSteps } from '../data/events';
import type { LandingEvent } from '../data/events';
import { reviews, ratingSummary } from '../data/testimonials';

interface Props {
  event: LandingEvent;
}

const { event } = Astro.props;
const tel = site.phone.replace(/[^\d+]/g, '');
---

<PageHero
  eyebrow={event.eyebrow}
  title={event.h1}
  breadcrumbs={[{ name: event.crumb, href: '' }]}
  image={event.heroImage}
  imageAlt={event.heroImageAlt}
/>

<!-- Intro -->
<section class="container-site py-14 md:py-16">
  <div class="mx-auto max-w-3xl">
    <div class="rich-links grid gap-5 text-[15px] leading-[1.85] text-white/75 md:text-base">
      {event.intro.map((para) => <p set:html={para} />)}
    </div>

    <p class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 text-[13px] font-semibold text-white/55">
      <span class="inline-flex items-center gap-2">
        <Icon name="check" class="h-4 w-4 text-gold" /> Licensed &amp; insured
      </span>
      <span class="inline-flex items-center gap-2">
        <Icon name="clock" class="h-4 w-4 text-gold" /> Booked 24/7
      </span>
      <a href="#rates" class="inline-flex items-center gap-1.5 text-gold underline underline-offset-4 hover:text-gold-bright">
        See 2026 rates <Icon name="arrow-right" class="h-4 w-4" />
      </a>
    </p>

    <div class="mt-9 flex flex-wrap gap-3">
      <a href={`tel:${tel}`} class="btn-gold">
        <Icon name="phone" class="h-4 w-4" />
        Call {site.phoneDisplay}
      </a>
      <a href="/contact/" class="btn-outline">Get a Free Quote</a>
    </div>
  </div>
</section>

<!-- Trust stats -->
<section class="border-y border-line bg-black/60">
  <div class="container-site grid grid-cols-2 gap-6 py-9 text-center md:grid-cols-4 md:py-11">
    {
      landingStats.map((stat) => (
        <div>
          <p class="font-display text-3xl font-bold text-gold md:text-4xl">{stat.value}</p>
          <p class="mt-1.5 text-[11px] font-semibold tracking-[0.14em] text-white/60 uppercase">
            {stat.label}
          </p>
        </div>
      ))
    }
  </div>
</section>

<!-- Why book -->
<section class="border-b border-line bg-black/40">
  <div class="container-site py-14 md:py-20">
    <div class="mx-auto max-w-3xl text-center">
      <p class="eyebrow">Why book with us</p>
      <h2 class="mt-4 font-display text-2xl font-bold text-white md:text-[34px]">
        Why groups choose 5 Star for {event.crumb}
      </h2>
    </div>

    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        event.highlights.map((item) => (
          <article class="card-dark flex h-full flex-col p-6">
            <span class="flex h-10 w-10 items-center justify-center rounded-full border border-gold/40 bg-gold/10">
              <Icon name="check" class="h-5 w-5 text-gold" />
            </span>
            <h3 class="mt-4 font-display text-lg font-bold text-white">{item.title}</h3>
            <p class="mt-2.5 text-sm leading-relaxed text-white/65">{item.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<!-- How it works -->
<section class="container-site py-14 md:py-20">
  <div class="mx-auto max-w-3xl text-center">
    <p class="eyebrow">How it works</p>
    <h2 class="mt-4 font-display text-2xl font-bold text-white md:text-[34px]">
      How to book your {event.keyword} in 3 steps
    </h2>
    <p class="mt-4 text-sm leading-relaxed text-white/65 md:text-base">
      Booking takes one phone call. Tell us your date, your group size and your stops and we
      handle the rest — no apps, no surge pricing, no surprises.
    </p>
  </div>

  <div class="mt-10 grid gap-6 md:grid-cols-3">
    {
      bookingSteps.map((step, i) => (
        <article class="card-dark flex h-full flex-col p-6">
          <span class="flex h-10 w-10 items-center justify-center rounded-full border border-gold/40 bg-gold/10 font-display text-lg font-bold text-gold">
            {i + 1}
          </span>
          <h3 class="mt-4 font-display text-lg font-bold text-white">{step.title}</h3>
          <p class="mt-2.5 text-sm leading-relaxed text-white/65">{step.body}</p>
        </article>
      ))
    }
  </div>

  <div class="mt-10 text-center">
    <a href={`tel:${tel}`} class="btn-gold">
      <Icon name="phone" class="h-4 w-4" />
      Check your date — {site.phoneDisplay}
    </a>
  </div>
</section>

<!-- Rates -->
<section id="rates" class="border-y border-line bg-black/40">
  <div class="container-site py-14 md:py-20">
    <div class="mx-auto max-w-3xl text-center">
      <p class="eyebrow">Rates &amp; packages</p>
      <h2 class="mt-4 font-display text-2xl font-bold text-white md:text-[34px]">
        2026 {event.keyword} rates in Orange County
      </h2>
      <p class="mt-4 text-sm leading-relaxed text-white/65 md:text-base">
        Transparent starting rates, a four-hour minimum on most vehicles, and a per-person cost
        that drops as your group grows. Split the total across the group and you will usually beat
        separate cars or surge-priced rides home.
      </p>
    </div>

    <div class="mt-10 overflow-x-auto">
      <table class="w-full min-w-[640px] border-collapse text-left text-sm">
        <thead>
          <tr class="border-b border-gold/30 text-[11px] tracking-[0.12em] text-gold uppercase">
            <th scope="col" class="py-3 pr-4 font-extrabold">Vehicle</th>
            <th scope="col" class="py-3 pr-4 font-extrabold">Seats</th>
            <th scope="col" class="py-3 pr-4 font-extrabold">Hourly rate</th>
            <th scope="col" class="py-3 font-extrabold">Best for</th>
          </tr>
        </thead>
        <tbody>
          {
            event.pricing.map((row) => (
              <tr class="border-b border-white/10 text-white/80">
                <th scope="row" class="py-3.5 pr-4 font-semibold text-white">{row.vehicle}</th>
                <td class="py-3.5 pr-4 whitespace-nowrap">{row.seats}</td>
                <td class="py-3.5 pr-4 font-bold whitespace-nowrap text-gold">{row.rate}</td>
                <td class="py-3.5">{row.best}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <p class="mt-5 text-[13px] leading-relaxed text-white/55">{event.pricingNote}</p>

    <div class="mt-8 flex flex-wrap gap-3">
      <a href={`tel:${tel}`} class="btn-gold">
        <Icon name="phone" class="h-4 w-4" />
        Get an exact quote
      </a>
      <a href="/party-bus-prices-orange-county/" class="btn-outline">
        Full 2026 price guide
      </a>
    </div>
  </div>
</section>

<!-- What's included + cities -->
<section class="container-site py-14 md:py-20">
  <div class="grid gap-10 lg:grid-cols-2 lg:items-start lg:gap-14">
    <div>
      <p class="eyebrow">What's included</p>
      <h2 class="mt-4 font-display text-2xl font-bold text-white md:text-[30px]">
        Every rental includes
      </h2>
      <ul class="mt-7 grid gap-3.5">
        {
          event.includes.map((item) => (
            <li class="flex items-start gap-3 text-[15px] leading-snug text-white/80">
              <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full border border-gold/40">
                <Icon name="check" class="h-3 w-3 text-gold" />
              </span>
              {item}
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <p class="eyebrow">Service area</p>
      <h2 class="mt-4 font-display text-2xl font-bold text-white md:text-[30px]">
        Cities we serve
      </h2>
      <p class="mt-4 text-sm leading-relaxed text-white/65">
        Pickup and drop-off available throughout Orange County and surrounding areas.
        Explore your city page for local details and availability.
      </p>
      <div class="mt-6 flex flex-wrap gap-2.5">
        {
          event.cities.map((city) => (
            <a
              href={city.href}
              class="rounded-full border border-white/10 bg-white/5 px-3.5 py-1.5 text-[13px] font-semibold text-white/75 transition-colors hover:border-gold/40 hover:text-gold"
            >
              {city.label}
            </a>
          ))
        }
        <a
          href="/cities/"
          class="rounded-full border border-gold/40 bg-gold/10 px-3.5 py-1.5 text-[13px] font-semibold text-gold transition-colors hover:bg-gold hover:text-ink"
        >
          All cities →
        </a>
      </div>
    </div>
  </div>
</section>

<!-- Popular routes -->
<section class="border-y border-line bg-black/40">
  <div class="container-site py-14 md:py-20">
    <div class="mx-auto max-w-3xl text-center">
      <p class="eyebrow">Where groups go</p>
      <h2 class="mt-4 font-display text-2xl font-bold text-white md:text-[34px]">
        Popular {event.keyword} routes across Orange County
      </h2>
      <p class="mt-4 text-sm leading-relaxed text-white/65 md:text-base">
        Not sure where to start? These are the routes our groups ask for most. Tell us your must-see
        spots and we will build the itinerary around your night.
      </p>
    </div>

    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {
        event.itineraries.map((trip) => (
          <article class="card-dark flex h-full flex-col p-6">
            <h3 class="flex items-start gap-2.5 font-display text-lg font-bold text-white">
              <Icon name="map-pin" class="mt-0.5 h-5 w-5 shrink-0 text-gold" />
              {trip.title}
            </h3>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-white/65">{trip.body}</p>
            <div class="mt-4 flex flex-wrap gap-x-4 gap-y-2 border-t border-white/10 pt-4">
              {trip.links.map((link) => (
                <a
                  href={link.href}
                  class="text-[12px] font-semibold text-gold underline underline-offset-4 transition-colors hover:text-gold-bright"
                >
                  {link.label} →
                </a>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<!-- Choose your ride -->
<section class="container-site py-14 md:py-20">
  <div class="mx-auto max-w-3xl text-center">
    <p class="eyebrow">The fleet</p>
    <h2 class="mt-4 font-display text-2xl font-bold text-white md:text-[34px]">
      Choose your ride
    </h2>
  </div>

  <div class="mt-10 grid gap-6 sm:grid-cols-2">
    {
      event.vehicles.map((vehicle) => (
        <a
          href={vehicle.href}
          class="card-dark group flex h-full flex-col p-6 transition-transform duration-300 hover:-translate-y-1.5"
        >
          <h3 class="flex items-center justify-between gap-3 font-display text-lg font-bold text-white">
            {vehicle.title}
            <Icon name="arrow-right" class="h-5 w-5 shrink-0 text-gold transition-transform group-hover:translate-x-1" />
          </h3>
          <p class="mt-3 text-sm leading-relaxed text-white/65">{vehicle.body}</p>
        </a>
      ))
    }
  </div>
</section>

<!-- Reviews -->
<section class="border-y border-line bg-black/40">
  <div class="container-site py-14 md:py-20">
    <div class="mx-auto max-w-3xl text-center">
      <p class="eyebrow">Reviews</p>
      <h2 class="mt-4 font-display text-2xl font-bold text-white md:text-[34px]">
        What Orange County groups say about our {event.keyword}
      </h2>
      <div class="mt-6 flex flex-col items-center gap-2">
        <div class="flex items-center gap-1 text-gold" aria-hidden="true">
          {[0, 1, 2, 3, 4].map((i) => <Icon name="star" class="h-5 w-5" />)}
        </div>
        <p class="text-sm text-white/55">
          {ratingSummary.label} · rated <strong class="text-white">{ratingSummary.rating}</strong> based on{' '}
          <strong class="text-white">{ratingSummary.total} reviews</strong> on {ratingSummary.source}
        </p>
      </div>
    </div>

    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {
        reviews.map((review) => (
          <figure class="card-dark flex h-full flex-col p-6">
            <div class="flex items-center gap-1 text-gold" aria-label={`${review.stars} out of 5 stars`}>
              {Array.from({ length: review.stars }).map(() => <Icon name="star" class="h-4 w-4" />)}
            </div>
            <blockquote class="mt-4 flex-1 text-sm leading-relaxed text-white/75">
              “{review.text}”
            </blockquote>
            <figcaption class="mt-4 flex items-center gap-3 border-t border-white/10 pt-4">
              <img
                src={review.avatar}
                alt=""
                class="h-9 w-9 rounded-full"
                loading="lazy"
                decoding="async"
              />
              <div>
                <p class="text-sm font-semibold text-white">{review.name}</p>
                <p class="text-[11px] text-white/45">via {review.source}</p>
              </div>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<!-- FAQ -->
<section class="container-site py-14 md:py-20">
  <div class="mx-auto max-w-3xl">
    <p class="eyebrow text-center">Good to know</p>
    <h2 class="mt-4 text-center font-display text-2xl font-bold text-white md:text-[34px]">
      {event.crumb} — frequently asked questions
    </h2>

    <div class="mt-9 grid gap-5">
      {
        event.faq.map((item, i) => (
          <div class="card-dark p-6">
            <h3 id={`faq-${i + 1}`} class="font-display text-base font-bold text-gold md:text-lg">
              {item.question}
            </h3>
            <p class="mt-3 text-[15px] leading-relaxed text-white/75">{item.answer}</p>
          </div>
        ))
      }
    </div>

    <div class="mt-10 text-center">
      <a href={`tel:${tel}`} class="btn-gold">
        <Icon name="phone" class="h-4 w-4" />
        Call {site.phoneDisplay}
      </a>
    </div>
  </div>
</section>

<!-- Related links -->
<section class="border-t border-line bg-black/40">
  <div class="container-site py-12 md:py-14">
    <p class="eyebrow text-center">Keep exploring</p>
    <div class="mx-auto mt-6 flex max-w-3xl flex-wrap justify-center gap-x-6 gap-y-3">
      {
        event.related.map((link) => (
          <a
            href={link.href}
            class="text-sm font-semibold text-white/65 underline-offset-4 transition-colors hover:text-gold hover:underline"
          >
            {link.label}
          </a>
        ))
      }
    </div>
  </div>
</section>

<CtaBand />

<style>
  /* gold underlined internal links inside set:html copy */
  .rich-links :global(a) {
    color: #e7c766;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    transition: color 0.2s ease;
  }

  .rich-links :global(a:hover) {
    color: #ffd700;
  }
</style>
