---
/** 404 — matches the "Page not found" experience of the original site. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import site from '../data/site';
---

<BaseLayout
  title="Page not found - 5 Star Limousine Service"
  description="The page you were looking for could not be found. Call 5 Star Limousine Service for limo and party bus rentals in Orange County."
  path="/404/"
  noindex={true}
>
  <section class="container-site flex min-h-[60vh] flex-col items-center justify-center py-20 text-center">
    <p class="font-accent text-[64px] leading-none font-bold text-gold md:text-[96px]">404</p>
    <h1 class="heading-gold mt-4 text-2xl font-bold md:text-3xl">Page Not Found</h1>
    <p class="mt-4 max-w-lg text-[15px] leading-relaxed text-white/65">
      The page you're looking for has moved or no longer exists. Let us get you where you need to go in style.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="btn-gold">Back to home</a>
      <a href={`tel:${site.phone.replace(/[^\d+]/g, '')}`} class="btn-outline">
        <Icon name="phone" class="h-4 w-4" />
        {site.phoneDisplay}
      </a>
    </div>
  </section>
</BaseLayout>
