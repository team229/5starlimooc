---
/**
 * Homepage "Upcoming Events in Orange County" section.
 *
 * Replaces the single-holiday Halloween banner with a unified, always-current
 * seasonal marketing block covering Halloween, homecoming and Oktoberfest /
 * fall festivals. Each card links to a dedicated landing page, and the section
 * carries the local-SEO keyword targets (event + party bus/limo + city).
 */
import Icon from './Icon.astro';
import site from '../data/site';
import { seasonalIntro, seasonalEvents } from '../data/events';

const tel = site.phone.replace(/[^\d+]/g, '');
---

<section id="events" class="relative overflow-hidden border-b border-line py-16 md:py-24">
  <!-- gold seasonal glow (kept subtle so the fixed starfield shows through) -->
  <div
    class="pointer-events-none absolute inset-0"
    style="background:
      radial-gradient(circle at 10% 0%, rgba(212,175,55,0.14) 0%, transparent 42%),
      radial-gradient(circle at 90% 100%, rgba(198,155,64,0.12) 0%, transparent 45%),
      radial-gradient(circle at 78% 12%, rgba(255,215,0,0.06) 0%, transparent 34%);"
  >
  </div>

  <div class="container-site relative">
    <!-- heading -->
    <div class="mx-auto max-w-3xl text-center">
      <span
        class="inline-flex items-center gap-2 rounded-full border border-gold/40 bg-gold/10 px-4 py-1.5 text-[11px] font-extrabold tracking-[0.18em] text-gold uppercase"
      >
        {seasonalIntro.eyebrow}
      </span>

      <h2 class="mt-6 font-display text-[30px] leading-[1.12] font-bold text-white md:text-[48px]">
        Upcoming Events in <span class="text-gold">Orange County</span>
      </h2>

      <p class="mt-6 text-[15px] leading-[1.85] text-white/70 md:text-base">{seasonalIntro.lead}</p>

      <div class="mt-7 flex flex-wrap items-center justify-center gap-x-6 gap-y-2.5 text-[12px] font-semibold tracking-wide text-white/60 uppercase">
        <span class="inline-flex items-center gap-2">
          <Icon name="star" class="h-4 w-4 text-gold" />
          Google-reviewed
        </span>
        <span class="inline-flex items-center gap-2">
          <Icon name="car" class="h-4 w-4 text-gold" />
          {site.yearsInBusiness} years in business
        </span>
        <span class="inline-flex items-center gap-2">
          <Icon name="check" class="h-4 w-4 text-gold" />
          Licensed &amp; insured
        </span>
        <span class="inline-flex items-center gap-2">
          <Icon name="clock" class="h-4 w-4 text-gold" />
          24/7 booking
        </span>
      </div>
    </div>

    <!-- event cards -->
    <div class="mt-12 grid gap-7 md:grid-cols-2 lg:grid-cols-3">
      {
        seasonalEvents.map((event) => (
          <article class="card-dark group flex flex-col overflow-hidden transition-transform duration-300 hover:-translate-y-1.5">
            <a href={event.href} class="relative block aspect-[16/10] overflow-hidden bg-black">
              <img
                src={event.image}
                alt={event.imageAlt}
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
                decoding="async"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/25 to-transparent" />
              <span class="absolute top-4 left-4 rounded-full border border-gold/45 bg-black/75 px-3 py-1 text-[10px] font-extrabold tracking-[0.16em] text-gold uppercase backdrop-blur-sm">
                {event.badge}
              </span>
              <span class="absolute bottom-4 left-4 text-[11px] font-bold tracking-[0.18em] text-gold uppercase">
                {event.season}
              </span>
            </a>

            <div class="flex flex-1 flex-col p-6">
              <h3 class="font-display text-xl leading-snug font-bold text-white">
                <a href={event.href} class="transition-colors hover:text-gold">
                  {event.title}
                </a>
              </h3>

              <p class="mt-3 text-sm leading-relaxed text-white/65">{event.blurb}</p>

              <ul class="mt-5 grid gap-2.5">
                {event.points.map((point) => (
                  <li class="flex items-start gap-2.5 text-[13px] leading-snug text-white/80">
                    <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full border border-gold/40">
                      <Icon name="check" class="h-3 w-3 text-gold" />
                    </span>
                    {point}
                  </li>
                ))}
              </ul>

              <div class="mt-auto pt-6">
                <div class="grid gap-2.5">
                  <a href={event.href} class="btn-gold w-full !py-3 text-[12px]">
                    {event.cta}
                    <Icon name="arrow-right" class="h-4 w-4" />
                  </a>
                  <a href={`tel:${tel}`} class="btn-outline w-full !py-3 text-[12px]">
                    <Icon name="phone" class="h-4 w-4" />
                    Check availability
                  </a>
                </div>

                <div class="mt-4 flex flex-wrap gap-x-4 gap-y-1.5 border-t border-white/10 pt-4 text-[12px]">
                  {event.links.map((link) => (
                    <a href={link.href} class="text-white/55 underline-offset-4 transition-colors hover:text-gold hover:underline">
                      {link.label}
                    </a>
                  ))}
                </div>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <!-- promo CTA -->
    <div class="relative mt-10 overflow-hidden rounded-xl border border-gold/25 bg-gradient-to-br from-[#0d0d0d] to-black px-6 py-10 text-center shadow-[0_12px_40px_rgba(0,0,0,0.6)]">
      <div class="absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-gold-deep via-gold-bright to-gold-deep" />
      <h3 class="font-accent text-2xl font-extrabold tracking-wide text-gold uppercase md:text-4xl">
        Get 1 Hour Free!
      </h3>
      <p class="mx-auto mt-3 max-w-xl text-sm text-white/70 md:text-base">{seasonalIntro.offer}</p>
      <div class="mt-7 flex flex-wrap justify-center gap-3">
        <a href={`tel:${tel}`} class="btn-gold">
          <Icon name="phone" class="h-4 w-4" />
          Call {site.phoneDisplay}
        </a>
        <a href="/contact/" class="btn-outline">Get a Free Quote</a>
      </div>
    </div>
  </div>
</section>
