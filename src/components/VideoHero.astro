---
/**
 * Full-bleed background-video hero with the gold 3D logo + H1.
 * Used by the homepage, city pages and the hub pages (/services/, /fleet/, ...),
 * matching the Elementor "background video" sections of the original site.
 */
const VIDEO_ID = 'EOsQl5ABpaA';
const videoSrc = `https://www.youtube-nocookie.com/embed/${VIDEO_ID}?autoplay=1&mute=1&controls=0&loop=1&playlist=${VIDEO_ID}&playsinline=1&rel=0&modestbranding=1&disablekb=1`;

interface Props {
  title: string;
  /** 'home' = compact banner, 'hub' = tall full-screen hero */
  size?: 'home' | 'hub';
  headingLevel?: 'h1' | 'h2';
}

const { title, size = 'home', headingLevel = 'h1' } = Astro.props;
const Heading = headingLevel;
const height = size === 'hub' ? 'min-h-[62vh] md:min-h-[78vh]' : 'min-h-[50vh] md:min-h-[62vh]';
const padding = size === 'hub' ? 'py-16 md:py-24' : 'py-12 md:py-16';
const width = size === 'hub' ? 'w-[280px] sm:w-[360px] md:w-[420px]' : 'w-[280px] sm:w-[380px] md:w-[480px]';
---

<section class={`relative flex ${height} items-center justify-center overflow-hidden bg-black`}>
  <div class="absolute inset-0">
    <iframe
      src={videoSrc}
      title="5 Star Limousine Service background video"
      class="pointer-events-none absolute top-1/2 left-1/2 h-[120%] min-w-[100vw] -translate-x-1/2 -translate-y-1/2 border-0"
      allow="autoplay; encrypted-media; picture-picture"
      tabindex="-1"
      aria-hidden="true"
    ></iframe>
    <div
      class="absolute inset-0"
      style="background: linear-gradient(to bottom, rgba(0,0,0,0.65) 0%, rgba(0,0,0,0.45) 50%, rgba(0,0,0,0.85) 100%);"
    >
    </div>
  </div>

  <div class={`container-site relative z-10 w-full text-center ${padding}`}>
    <img
      src="/images/wp-content/uploads/2024/09/5STAR-B.png"
      alt="5 Star Limousine"
      class={`mx-auto mb-6 h-auto ${width} drop-shadow-[0_10px_40px_rgba(0,0,0,0.8)]`}
      width="480"
      height="324"
      fetchpriority="high"
      decoding="async"
    />
    <Heading class="heading-gold mx-auto max-w-4xl text-[24px] leading-[1.25] font-bold text-white sm:text-[30px] md:text-[40px]">
      {title}
    </Heading>
  </div>
</section>
