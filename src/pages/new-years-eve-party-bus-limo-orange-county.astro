---
/**
 * New Year's Eve party bus & limo landing page.
 * Composition only — all copy lives in src/data/events.ts and the shared
 * EventLandingPage component.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import EventLandingPage from '../components/EventLandingPage.astro';
import { newYearsEveLanding, buildEventSchema } from '../data/events';

const event = newYearsEveLanding;
const schema = buildEventSchema({
  ...event.event,
  image: event.heroImage,
  url: event.path,
});
---

<BaseLayout
  title={event.metaTitle}
  description={event.metaDescription}
  path={event.path}
  image={event.heroImage}
  breadcrumbs={[{ name: event.crumb, href: '' }]}
  faq={event.faq}
  events={[schema]}
>
  <EventLandingPage event={event} />
</BaseLayout>
